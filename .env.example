# Landing Client Environment Variables

# Run `pnpm env:ssm dev PACIFIC-PROD` to generate .env.local from
# /tsuru/dev/landing. reboot-server.sh runs this automatically.
# Required public browser configuration (generated values override this file):
VITE_PUBLIC_API_URL=https://public-api.tsuru.jcampos.dev
VITE_PUBLIC_IDENTITY_POOL_ID=
VITE_AWS_REGION=us-east-1

# Base domain for display purposes (e.g., "tu-tienda.DOMAIN")
VITE_BASE_DOMAIN=tsuru.jcampos.dev

# Full URL of the store app (including protocol)
# For localhost development:
VITE_APP_URL=http://localhost:9000

# For production:
# VITE_APP_URL=https://app.tsuru.jcampos.dev

# VITE_API_URL is only used by the legacy development admin surface.
# Public examples and editorial content use VITE_PUBLIC_API_URL with guest signing.
